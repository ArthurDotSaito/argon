{
  "name": "Argon",
  "author": "Argon",
  "themes": [
    {
      "name": "One Dark",
      "mode": "dark",
      "is_default": true,
      "font.family": "IBM Plex Sans",
      "font.size": 16,
      "mono_font.family": "Lilex",
      "mono_font.size": 13,
      "radius": 4,
      "radius.lg": 6,
      "shadow": false,
      "colors": {
        "background": "#282c33",
        "foreground": "#dce0e5",
        "border": "#464b57",
        "input.border": "#464b57",
        "ring": "#74ade8",
        "caret": "#74ade8",
        "link": "#74ade8",
        "muted.background": "#2f343e",
        "muted.foreground": "#a9afbc",
        "accent.background": "#3b414d",
        "accent.foreground": "#dce0e5",
        "primary.background": "#74ade8",
        "primary.foreground": "#282c33",
        "secondary.background": "#3b414d",
        "secondary.foreground": "#dce0e5",
        "secondary.hover.background": "#464b57",
        "secondary.active.background": "#464b57",
        "popover.background": "#2f343e",
        "popover.foreground": "#dce0e5",
        "list.background": "#282c33",
        "list.hover.background": "#3b414d",
        "list.active.background": "#74ade833",
        "list.active.border": "#74ade8",
        "selection.background": "#74ade84d",
        "scrollbar.background": "#00000000",
        "scrollbar.thumb.background": "#464b57",
        "scrollbar.thumb.hover.background": "#a9afbc",
        "sidebar.background": "#2f343e",
        "sidebar.foreground": "#dce0e5",
        "sidebar.border": "#464b57",
        "sidebar.accent.background": "#3b414d",
        "sidebar.accent.foreground": "#dce0e5",
        "tab_bar.background": "#2f343e",
        "tab.background": "#2f343e",
        "tab.foreground": "#a9afbc",
        "tab.active.background": "#282c33",
        "tab.active.foreground": "#dce0e5",
        "title_bar.background": "#2f343e",
        "title_bar.border": "#464b57",
        "status_bar.background": "#2f343e",
        "status_bar.border": "#464b57",
        "drag.border": "#74ade8",
        "drop_target.background": "#74ade826",
        "success.background": "#a1c181",
        "success.foreground": "#282c33",
        "warning.background": "#dec184",
        "warning.foreground": "#282c33",
        "danger.background": "#d07277",
        "danger.foreground": "#282c33",
        "info.background": "#74ade8",
        "info.foreground": "#282c33",
        "base.blue": "#74ade8",
        "base.green": "#a1c181",
        "base.yellow": "#dec184",
        "base.red": "#d07277",
        "base.magenta": "#b477cf"
      },
      "highlight": {
        "syntax": {
          "attribute": { "color": "#74ade8" },
          "boolean": { "color": "#bf956a" },
          "comment": { "color": "#5d636f" },
          "comment_doc": { "color": "#878e98" },
          "constant": { "color": "#dfc184" },
          "constructor": { "color": "#73ade9" },
          "embedded": { "color": "#dce0e5" },
          "emphasis": { "color": "#74ade8" },
          "emphasis.strong": { "color": "#bf956a", "font_weight": 700 },
          "enum": { "color": "#6eb4bf" },
          "function": { "color": "#73ade9" },
          "hint": { "color": "#788ca6" },
          "keyword": { "color": "#b477cf" },
          "label": { "color": "#74ade8" },
          "link_text": { "color": "#73ade9", "font_style": "italic" },
          "link_uri": { "color": "#6eb4bf" },
          "number": { "color": "#bf956a" },
          "operator": { "color": "#6eb4bf" },
          "predictive": { "color": "#5a6a87", "font_style": "italic" },
          "preproc": { "color": "#b477cf" },
          "primary": { "color": "#acb2be" },
          "property": { "color": "#d07277" },
          "punctuation": { "color": "#acb2be" },
          "punctuation.bracket": { "color": "#b2b9c6" },
          "punctuation.delimiter": { "color": "#b2b9c6" },
          "punctuation.list_marker": { "color": "#d07277" },
          "punctuation.special": { "color": "#b1574b" },
          "string": { "color": "#a1c181" },
          "string.escape": { "color": "#878e98" },
          "string.regex": { "color": "#bf956a" },
          "string.special": { "color": "#bf956a" },
          "string.special.symbol": { "color": "#bf956a" },
          "tag": { "color": "#74ade8" },
          "text.literal": { "color": "#a1c181" },
          "title": { "color": "#d07277", "font_weight": 400 },
          "type": { "color": "#6eb4bf" },
          "variable": { "color": "#acb2be" },
          "variable.special": { "color": "#bf956a" },
          "variant": { "color": "#73ade9" }
        }
      }
    }
  ]
}
