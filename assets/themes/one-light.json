{
  "name": "Argon",
  "author": "Argon",
  "themes": [
    {
      "name": "One Light",
      "mode": "light",
      "is_default": true,
      "font.family": "IBM Plex Sans",
      "font.size": 16,
      "mono_font.family": "Lilex",
      "mono_font.size": 13,
      "radius": 4,
      "radius.lg": 6,
      "shadow": false,
      "colors": {
        "background": "#fafafa",
        "foreground": "#242529",
        "border": "#c9c9ca",
        "input.border": "#c9c9ca",
        "ring": "#4560cc",
        "caret": "#4560cc",
        "link": "#4560cc",
        "muted.background": "#f0f0f1",
        "muted.foreground": "#58585a",
        "accent.background": "#ebebec",
        "accent.foreground": "#242529",
        "primary.background": "#4560cc",
        "primary.foreground": "#fafafa",
        "secondary.background": "#ebebec",
        "secondary.foreground": "#242529",
        "secondary.hover.background": "#dfdfe0",
        "secondary.active.background": "#dfdfe0",
        "popover.background": "#ebebec",
        "popover.foreground": "#242529",
        "list.background": "#fafafa",
        "list.hover.background": "#ebebec",
        "list.active.background": "#4560cc26",
        "list.active.border": "#4560cc",
        "selection.background": "#4560cc40",
        "scrollbar.background": "#00000000",
        "scrollbar.thumb.background": "#c9c9ca",
        "scrollbar.thumb.hover.background": "#58585a",
        "sidebar.background": "#f0f0f1",
        "sidebar.foreground": "#242529",
        "sidebar.border": "#c9c9ca",
        "sidebar.accent.background": "#ebebec",
        "sidebar.accent.foreground": "#242529",
        "tab_bar.background": "#f0f0f1",
        "tab.background": "#f0f0f1",
        "tab.foreground": "#58585a",
        "tab.active.background": "#fafafa",
        "tab.active.foreground": "#242529",
        "title_bar.background": "#f0f0f1",
        "title_bar.border": "#c9c9ca",
        "status_bar.background": "#f0f0f1",
        "status_bar.border": "#c9c9ca",
        "drag.border": "#4560cc",
        "drop_target.background": "#4560cc26",
        "success.background": "#3f7a34",
        "success.foreground": "#fafafa",
        "warning.background": "#85690a",
        "warning.foreground": "#fafafa",
        "danger.background": "#b8412f",
        "danger.foreground": "#fafafa",
        "info.background": "#4560cc",
        "info.foreground": "#fafafa",
        "base.blue": "#4560cc",
        "base.green": "#3f7a34",
        "base.yellow": "#85690a",
        "base.red": "#b8412f",
        "base.magenta": "#6a6cc0"
      },
      "highlight": {
        "syntax": {
          "attribute": { "color": "#5c78e2" },
          "boolean": { "color": "#ad6e25" },
          "comment": { "color": "#a2a3a7" },
          "comment_doc": { "color": "#7c7e86" },
          "constant": { "color": "#c18401" },
          "constructor": { "color": "#5c78e2" },
          "embedded": { "color": "#242529" },
          "emphasis": { "color": "#5c78e2" },
          "emphasis.strong": { "color": "#ad6e25", "font_weight": 700 },
          "enum": { "color": "#3882b7" },
          "function": { "color": "#5b79e3" },
          "hint": { "color": "#7274a7" },
          "keyword": { "color": "#a449ab" },
          "label": { "color": "#5c78e2" },
          "link_text": { "color": "#5b79e3", "font_style": "italic" },
          "link_uri": { "color": "#3882b7" },
          "number": { "color": "#ad6e25" },
          "operator": { "color": "#3882b7" },
          "predictive": { "color": "#9b9ec6", "font_style": "italic" },
          "preproc": { "color": "#a449ab" },
          "primary": { "color": "#242529" },
          "property": { "color": "#d3604f" },
          "punctuation": { "color": "#242529" },
          "punctuation.bracket": { "color": "#4d4f52" },
          "punctuation.delimiter": { "color": "#4d4f52" },
          "punctuation.list_marker": { "color": "#d3604f" },
          "punctuation.special": { "color": "#b92b46" },
          "string": { "color": "#649f57" },
          "string.escape": { "color": "#7c7e86" },
          "string.regex": { "color": "#ad6e26" },
          "string.special": { "color": "#ad6e26" },
          "string.special.symbol": { "color": "#ad6e26" },
          "tag": { "color": "#5c78e2" },
          "text.literal": { "color": "#649f57" },
          "title": { "color": "#d3604f", "font_weight": 400 },
          "type": { "color": "#3882b7" },
          "variable": { "color": "#242529" },
          "variable.special": { "color": "#ad6e25" },
          "variant": { "color": "#5b79e3" }
        }
      }
    }
  ]
}
